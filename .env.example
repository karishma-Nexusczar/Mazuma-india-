# Configure either Resend or your own server-side mail provider before deploying.
RESEND_API_KEY=re_your_key
ENQUIRY_FROM=Taxtation Mazuma <website@your-domain.com>

# Optional Supabase table: enquiries (name, phone, email, service, message, source, created_at, ip_address)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
